{
  "name": "senate-town",
  "private": true,
  "version": "0.1.0",
  "description": "Town: a Senate's live activity as a little town of workshops, tubes and townspeople — a Phaser 4 page that runs in a browser and in the Senate app.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "tiles": "swift tools/make-tiles.swift assets/ground.png",
    "map": "node tools/make-map.mjs",
    "record": "node tools/record.mjs",
    "build": "node tools/build.mjs",
    "pack": "node tools/build.mjs && node tools/pack.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "serve": "python3 -m http.server -d dist 8765"
  },
  "dependencies": {
    "@senate/observe": "file:../senate/packages/senate-observe",
    "@senate/scene-host": "file:../senate/packages/senate-scene-host",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
